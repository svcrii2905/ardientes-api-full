{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "check": "deno check src/main.ts",
    "lint": "deno lint src/"
  },
  "imports": {
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "mysql": "https://deno.land/x/mysql@v2.12.1/mod.ts",
    "dotenv": "https://deno.land/std@0.224.0/dotenv/mod.ts",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "jose": "npm:jose@^5",
    "nodemailer": "npm:nodemailer@^6.9.13",
    "asserts": "https://deno.land/std@0.203.0/testing/asserts.ts"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": false
  }
}
